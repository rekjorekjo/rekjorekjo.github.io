---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import BinaryFlow from '../components/BinaryFlow.astro';
import { getPosts } from '../lib/posts';
import { withBase } from '../lib/paths';
import '../styles/home.css';
const recentPosts = (await getPosts()).slice(0, 6);
---
<Base>
  <main id="main" class="latest-page shell">
    <section class="latest-region" aria-labelledby="latest-title">
      <BinaryFlow />
      <header class="latest-heading">
        <h1 id="latest-title"><span data-i18n="latest">最新文章</span><span class="latest-count mono">{String(recentPosts.length).padStart(2, '0')}</span></h1>
        <a class="text-link" href={withBase('archive/')}><span data-i18n="allPosts">所有文章</span> <span aria-hidden="true">↗</span></a>
      </header>
      <div class="latest-list">
        <PostList posts={recentPosts} />
        {recentPosts.length === 0 && <p id="home-empty" class="page-intro" data-i18n="homeEmpty">还没有发布的文章，新的笔记正在整理中。</p>}
      </div>
    </section>
  </main>
</Base>
