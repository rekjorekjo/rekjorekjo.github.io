---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
import { author, site } from '../config';
const avatar = author.avatar ? (/^https?:\/\//.test(author.avatar) ? author.avatar : withBase(author.avatar)) : '';
const contacts = [
  { label: '邮箱', value: author.email, href: author.email ? `mailto:${author.email}` : '' },
  { label: 'GitHub', value: author.github ? author.github.replace(/^https?:\/\//, '').replace(/\/$/, '') : '', href: author.github },
  { label: 'X', value: author.x ? author.x.replace(/^https?:\/\//, '').replace(/\/$/, '') : '', href: author.x },
].filter(contact => contact.href);
const showContacts = author.showContacts && contacts.length > 0;
const showBlogInfo = author.showBlogInfo && author.blogParagraphs.some(paragraph => paragraph.trim());
---
<Base title={`关于 / ${site.name}`} active="about">
  <main id="main" class="shell about-page">
    <h1>关于</h1>
    <section class="profile-panel" aria-labelledby="profile-name">
      <div class="profile-avatar">
        {avatar ? <img src={avatar} alt={`${author.name} 的头像`} loading="eager" /> : <span aria-label="默认头像">{(author.name || site.name).slice(0, 1)}</span>}
      </div>
      <div class="profile-identity">
        <h2 id="profile-name">{author.name || site.name}</h2>
        {author.id && <p class="profile-id mono">@{author.id.replace(/^@/, '')}</p>}
        {author.signature && <p class="profile-signature">{author.signature}</p>}
        {author.bio && <p class="profile-bio">{author.bio}</p>}
        {author.tags.length > 0 && <div class="profile-interests" aria-label="个人标签">
          {author.tags.map(tag => <span>{tag}</span>)}
        </div>}
      </div>
    </section>

    {showContacts && <section class="about-section" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title">联系方式</h2>
      <dl class="profile-contacts">
        {contacts.map(contact => <div class="profile-contact">
          <dt>{contact.label}</dt>
          <dd><a href={contact.href} target={contact.label === '邮箱' ? undefined : '_blank'} rel={contact.label === '邮箱' ? undefined : 'noopener noreferrer'}>{contact.value}<span aria-hidden="true"> ↗</span></a></dd>
        </div>)}
      </dl>
    </section>}

    {showBlogInfo && <section class="about-section" aria-labelledby="about-notes-title">
      <h2 id="about-notes-title">关于这个博客</h2>
      {author.blogParagraphs.filter(paragraph => paragraph.trim()).map(paragraph => <p>{paragraph}</p>)}
      <div class="about-explore">
        <a href={withBase('/archive/')}>文章归档 <span aria-hidden="true">↗</span></a>
        <a href={withBase('/categories/')}>分类目录 <span aria-hidden="true">↗</span></a>
      </div>
    </section>}
  </main>
</Base>
